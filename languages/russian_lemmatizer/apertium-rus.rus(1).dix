  <pardefs>     
 
<!-- PARDEFS SECTION BEGINS HERE -->

    <!-- PARDEFS: Punctuation -->  

    <pardef n="numeros">
      <e><p><l>№</l><r>№</r></p><re>[0-9]+</re><p><l/><r><s n="num"/></r></p></e>
      <e><re>[0-9]+([ ][0-9]+)+</re><p><l/><r><s n="num"/></r></p></e>
      <e><re>[0-9]+([.,][0-9]+)?</re><p><l/><r><s n="num"/></r></p></e>
      <e><re>[№%]?[0-9]+([.,][0-9]+)* ?%</re><p><l/><r><s n="num"/><s n="percent"/></r></p></e>
      <e><re>[0-9]+([.,][0-9]+)?</re><i>-</i><re>[0-9]+([.,][0-9]+)?%?</re><p><l/><r><s n="num"/></r></p></e>
      <e><re>[0-9]+([.,][0-9]+)?[:.][0-9]+([.,][0-9]+)?</re><p><l/><r><s n="num"/></r></p></e>
      <e><re>[IXV]+</re><p><l/><r><s n="num"/><s n="roman"/></r></p></e>
    </pardef>
  
    <pardef n="quantitats">
      <e><re>[0-9]+([.,][0-9]+)?</re><p><l><b/>км</l><r><b/>км<s n="num"/></r></p></e>
      <e><re>[0-9]+([.,][0-9]+)?</re><p><l><b/>мм</l><r><b/>мм<s n="num"/></r></p></e>
      <e><re>[0-9]+([.,][0-9]+)?</re><p><l><b/>см</l><r><b/>см<s n="num"/></r></p></e>
      <e><re>[0-9]+([.,][0-9]+)?</re><p><l><b/>кг</l><r><b/>kг<s n="num"/></r></p></e>
    </pardef>
  
    <pardef n="guio">
      <e><re>[—\-]+</re><p><l/><r><s n="guio"/></r></p></e>
      <e><p><l>–</l><r>–<s n="guio"/></r></p></e>
    </pardef>
  
    <pardef n="coma">
      <e><re>,</re><p><l/><r><s n="cm"/></r></p></e>
    </pardef>
  
    <pardef n="separa">
      <e><re>[.\?;:!…"]+</re><p><l/><r><s n="sent"/></r></p></e>
    </pardef>
  
    <pardef n="quotes">
      <e><re>[«“„]+</re><p><l/><r><s n="lquot"/></r></p></e>
      <e><re>[»”“]+</re><p><l/><r><s n="rquot"/></r></p></e>
    </pardef>
  
    <pardef n="paresq">
      <e><re>[\(\[]</re><p><l/><r><s n="lpar"/></r></p></e>
    </pardef>
  
    <pardef n="pardret">
      <e><re>[\)\]]</re><p><l/><r><s n="rpar"/></r></p></e>
    </pardef>
       
